# AI 服务（OpenAI Chat Completions 兼容接口）
# Key 只保存在后端，不会下发到浏览器。
TIMETABLE_AI_API_KEY=
TIMETABLE_AI_BASE_URL=https://api.openai.com/v1
TIMETABLE_AI_MODEL=gpt-4o-mini
TIMETABLE_AI_TIMEOUT=60
TIMETABLE_AI_RATE_LIMIT=1

# 数据库。Docker 中已覆盖为 /data/timetable.db
DATABASE_URL=sqlite:///./data/timetable.db

# 日志
APP_ENV=dev
LOG_LEVEL=INFO

# 本地服务器入口：python -m server
TIMETABLE_HOST=127.0.0.1
TIMETABLE_PORT=8000
TIMETABLE_RELOAD=false

# Docker 构建源（网络可访问官方源时可改为 docker.io / npmjs.org / pypi.org）
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
